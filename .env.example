# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Find your project ID at https://code.earthengine.google.com/
# Then authenticate once with: earthengine authenticate

GEE_PROJECT_ID=your-gee-project-id

# Google Cloud project used to bill historical GDELT BigQuery queries.
GDELT_BILLING_PROJECT=your-gcp-billing-project-id

# OpenAI API key used by the GPT-5.6 Luna article-event classifier.
OPENAI_API_KEY=your-openai-api-key
RUN_ARTICLE_SUPPLEMENT=0
GDELT_SUPPLEMENT_MAX_TIB=0.25
RUN_LLM_QA=0
LLM_QA_MODEL=gpt-5.6-luna

# SITS-Extreme-VAE (RaVAEn) checkpoint for src/run_sits_inference.py: a .pth file
# or the directory holding checkpoint_vae_contrastive_{42,43,44}.pth, from
# https://github.com/hfangcat/SITS-ExtremeEvents (commit 637423d6370a31701612fc258782615c0c82e4e9).
# Leave empty to use SITS-ExtremeEvents-main/checkpoints/ravaen/ inside or beside the repository.
CVND_SITS_CHECKPOINT=

# Register at https://public.emdat.be/register and obtain API access after login.
# The key is sent directly in the GraphQL Authorization header.
EMDAT_API_KEY=your-emdat-api-key
